# Copie este arquivo para ".env" e preencha os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# ---- Parte 1 | Coleta GitHub ----
# Personal Access Token do GitHub (basta o escopo "public_repo" / leitura pública).
# Sem token o script ainda funciona, mas com limite de 60 req/hora em vez de 5000.
GITHUB_TOKEN=

# Organização a ser coletada (usada pelo case: apache, microsoft, google, vercel...)
GITHUB_ORG=apache

# ---- Parte 3 | Classificação de conversas com Gemini ----
GEMINI_API_KEY=

# Modelo principal solicitado. Se a chamada falhar (modelo inexistente/indisponível),
# o script tenta automaticamente o(s) modelo(s) em GEMINI_FALLBACK_MODELS, nessa ordem.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
